# Copia este archivo como config/.env y ajusta los valores.
APP_NAME="Sistema del cliente"
# URL pública que apunta a la carpeta /public (sin barra final)
APP_URL=http://localhost:8090
# production | development
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
SESSION_IDLE_MINUTES=120

# Base de datos PROPIA de este sistema
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cliente_sistema
DB_USER=root
DB_PASS=

# Tamaño máximo de imágenes en MB
UPLOAD_MAX_MB=3

# Usuario administrador inicial que crea database/install.php
INSTALL_ADMIN_NAME="Administrador"
INSTALL_ADMIN_EMAIL=admin@ejemplo.com
INSTALL_ADMIN_PASSWORD=
