# Copia este archivo como .env y rellena los valores. El .env NUNCA va a Git.
# Plantilla para proyectos Django (para sistemas PHP usa base-sistemas-php/config/.env.example).

DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false            # true solo en local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=

# Base de datos: mysql en producción; sqlite solo en local
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo (sin EMAIL_HOST se guardan como archivos en sent_emails/)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
SHOP_NOTIFY_EMAILS=           # correos que reciben avisos de pedidos, comprobantes y reservas

# Integraciones (solo las que use el proyecto; se usan desde el servidor, nunca en el navegador)
WHATSAPP_NUMBER=              # número público del negocio para los enlaces wa.me
WHATSAPP_CLOUD_TOKEN=         # Premium: avisos por WhatsApp Cloud API
WHATSAPP_CLOUD_PHONE_ID=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
WEB3FORMS_KEY=                # formularios sin trastienda
